---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { categoryLabels, formatPostDate, getPublishedPosts } from '../../lib/posts';
const posts = await getPublishedPosts();
---

<Base
  sky
  title="Blog — Jeff Li"
  description="Reflections on learning, concepts explained, and logs from my projects."
>
  <Header />
  <main id="main" class="collection-page section-shell">
    <a class="back-link" href="/">
      ← Back to main page
    </a>
    <header class="page-intro">
      <h1>Blog</h1>
    </header>
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>
            {formatPostDate(post.data.date, 'short')}
          </time>
          <a class="post-row" href={`/blog/${post.id}/`}>
            <span class="post-category">{categoryLabels[post.data.category]}</span>
            <h2>{post.data.title}</h2>
          </a>
        </li>
      ))}
    </ol>
    {posts.length === 0 && (
      <p class="empty-state">
        The first posts are on their way. Check back soon.
      </p>
    )}
  </main>
</Base>
