---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { categoryLabels, formatPostDate, getPublishedPosts } from '../../lib/posts';
import '../../styles/personal-home.css';
const posts = await getPublishedPosts();
---

<Base
  sky="hills"
  title="Blog — Jeff Li"
  description="Reflections on learning, concepts explained, and logs from my projects."
>
  <div class="personal-home">
    <Header illustrated />
    <main id="main" class="personal-copy">
      <div class="personal-reading">
        <h1>Blog</h1>
        <ol class="entry-list">
          {posts.map((post) => (
            <li>
              <time class="entry-date" datetime={post.data.date.toISOString()}>
                {formatPostDate(post.data.date, 'short')}
              </time>
              <a class="entry-row" href={`/blog/${post.id}/`}>
                <span class="entry-label">{categoryLabels[post.data.category]}</span>
                <h2>{post.data.title}</h2>
              </a>
            </li>
          ))}
        </ol>
        {posts.length === 0 && (
          <p class="empty-state">
            The first posts are on their way. Check back soon.
          </p>
        )}
      </div>
    </main>
  </div>
</Base>
