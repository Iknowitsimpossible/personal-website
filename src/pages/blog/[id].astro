---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { categoryLabels, formatPostDate, getPublishedPosts } from '../../lib/posts';
import '../../styles/personal-home.css';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
---

<Base title={`${data.title} — Jeff Li`} description={data.summary}>
  <div class="personal-home">
    <Header illustrated />
    <main id="main" class="personal-copy">
      <article class="personal-reading detail-page post-page">
        <header class="detail-intro">
          <p class="entry-label">
            {categoryLabels[data.category]} ·{' '}
            <time datetime={data.date.toISOString()}>{formatPostDate(data.date)}</time>
          </p>
          <h1>{data.title}</h1>
          {data.cover ? (
            <img class="detail-cover-image" src={data.cover.src} alt={data.cover.alt}
              width={data.cover.width} height={data.cover.height} />
          ) : (
            <p class="detail-deck">{data.summary}</p>
          )}
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    </main>
  </div>
</Base>
