---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPublishedPosts } from '../lib/posts';
import { getPublishedProjects } from '../lib/projects';
import '../styles/personal-home.css';

const latestPost = (await getPublishedPosts())[0];
const agentProject = (await getPublishedProjects()).find(({ id }) => id === 'scottylab-ai');
---

<Base description="Jeff Li, a Statistics and Machine Learning undergraduate at Carnegie Mellon. A few things I’m working on, learning, and enjoying.">
  <div class="personal-home">
    <Header illustrated />
    <main id="main" class="personal-copy">
      <div class="personal-reading">
        <h1>Hi, I’m Jeff.</h1>
        <p>
          I’m an undergraduate at <em>Carnegie Mellon University</em>, studying{' '}
          <strong><em>Statistics and Machine Learning</em></strong>, with minors in{' '}
          <em>Artificial Intelligence</em> and <em>Philosophy</em>.
        </p>
        <p>
          I enjoy building <a href="/projects/"><em>things</em></a>, researching cool problems in{' '}
          <a href="/research-and-coding/"><em>ML and astrophysics</em></a>, and sharing a laugh along the way.
        </p>
        <section aria-labelledby="now-title">
          <h2 id="now-title">Right now</h2>
          {agentProject && (
            <p>
              I’m part of the Agent team at{' '}
              <a href={`/projects/${agentProject.id}/`}><em>ScottyLabs AI</em></a>,
              connecting AI applications with CMU campus data and services.
              Along the way, I’m learning backend development, API integration,
              and how to build real-life AI applications with a team.
            </p>
          )}
          <p>
            I’m also writing down what I’m learning.
            {latestPost && (
              <>{' '}Most recently:{' '}
                <a href={`/blog/${latestPost.id}/`}><em>{latestPost.data.title}</em></a>.
              </>
            )}
          </p>
        </section>
        <section aria-labelledby="interests-title">
          <h2 id="interests-title">Away from the screen</h2>
          <p>
            You’ll find me playing soccer, wondering about the{' '}
            <a href="https://digital-observatory.vercel.app/" target="_blank" rel="noopener noreferrer"><em>universe</em></a>,
            or taking things slowly in <em>Stardew Valley</em>.
          </p>
          <p>
            I also love <em>traveling</em>, partly because I’m a fan of <em>Laozi</em>!
          </p>
        </section>
        <div class="personal-contact">
          <SocialLinks />
          <p class="personal-contact-note">
            <span class="contact-pointer" aria-hidden="true">←</span>
            You can contact me here.
          </p>
        </div>
      </div>
    </main>
  </div>
</Base>
