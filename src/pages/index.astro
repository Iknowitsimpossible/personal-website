---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPublishedPosts } from '../lib/posts';
import { getPublishedProjects } from '../lib/projects';
import '../styles/personal-home.css';

const latestPost = (await getPublishedPosts())[0];
const projects = await getPublishedProjects();
const selectedProjects = projects.filter(({ data }) => data.featured);
const agentProject = projects.find(({ id }) => id === 'scottylab-ai');
---

<Base description="Jeff Li, a Statistics and Machine Learning undergraduate at Carnegie Mellon. A few things I’m working on, learning, and enjoying.">
  <div class="personal-home">
    <Header illustrated />
    <main id="main" class="personal-copy">
      <div class="personal-reading home-sections">
        <div class="personal-intro">
          <div class="personal-intro-text">
            <h1>Hi, I’m Jeff.</h1>
            <p>
              I’m an undergraduate at Carnegie Mellon University, studying{' '}
              <strong>Statistics and Machine Learning</strong>. I am super interested in{' '}
              Artificial Intelligence, Philosophy, and Astrophysics.
            </p>
            <p>
              I enjoy building <a href="/projects/">things</a> and researching cool problems in{' '}
              <a href="/research-and-coding/">ML and astrophysics</a>.
            </p>
          </div>
          <div class="portrait-frame">
            <img
              class="personal-portrait"
              src="/images/jeff-portrait.jpg"
              width="480"
              height="720"
              alt="Jeff wearing a plush red Mario hat on top of a baseball cap"
            />
          </div>
        </div>
        <section aria-labelledby="now-title">
          <h2 id="now-title">Right now</h2>
          {agentProject && (
            <p>
              I’m part of the Agent team at{' '}
              <a href={`/projects/${agentProject.id}/`}>ScottyLabs AI</a>.
              I’m learning backend development and how to build real-life AI applications.
            </p>
          )}
          <p>
            I’m also writing down what I’m learning.
            {latestPost && (
              <>{' '}Most recently:{' '}
                <a href={`/blog/${latestPost.id}/`}>{latestPost.data.title}</a>.
              </>
            )}
          </p>
        </section>
        <section aria-labelledby="selected-title">
          <h2 id="selected-title">Selected work</h2>
          <p>
            {selectedProjects.map(({ id, data }, index) => (
              <>
                {index > 0 && <br />}
                <a href={`/projects/${id}/`}>{data.title}</a>
              </>
            ))}
          </p>
        </section>
        <section aria-labelledby="interests-title">
          <h2 id="interests-title">Away from the screen</h2>
          <p>
            You’ll find me playing soccer, wondering about the{' '}
            <a href="https://digital-observatory.vercel.app/" target="_blank" rel="noopener noreferrer">universe</a>,
            or taking things slowly in <em>Stardew Valley</em>.
          </p>
          <p>
            I also love traveling.
          </p>
        </section>
        <div class="personal-contact">
          <SocialLinks />
          <p class="personal-contact-note">
            <span class="contact-pointer" aria-hidden="true">←</span>
            You can contact me here.
          </p>
        </div>
      </div>
    </main>
  </div>
</Base>
