---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import GitHubIcon from '../../components/GitHubIcon.astro';
import { getPublishedProjects } from '../../lib/projects';
export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: {
      project,
    },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={`${data.title} — Jeff Li`} description={data.summary}>
  <Header />
  <main id="main" class="project-page section-shell" data-project={project.id}>
    <a class="back-link" href="/projects/">
      ← All projects
    </a>
    <header class="page-intro">
      <p class="eyebrow">
        {data.category} / {data.year}
      </p>
      <h1>{data.title}</h1>
      <p class="project-deck">{data.summary}</p>
      {data.sample && (
        <p class="sample-notice">
          Sample project — an illustrative concept, not a claim of completed
          work.
        </p>
      )}
    </header>
    <ProjectCover project={project} eager />
    <div class="project-story project-story-compact">
      <article class="prose">
        <Content />
      </article>
        {(data.website || data.github) && (
          <div class="project-outbound">
            {data.website && (
              <a
                class="outline-link"
                href={data.website}
                target="_blank"
                rel="noopener noreferrer"
              >
                {data.websiteLabel ?? 'Visit website'} ↗
              </a>
            )}
            {data.github && (
              <a
                class="outline-link"
                href={data.github}
                aria-label="View on GitHub"
                title="View on GitHub"
                target="_blank"
                rel="noopener noreferrer"
              >
                View on <GitHubIcon />
              </a>
            )}
          </div>
        )}
    </div>
    {data.gallery.length > 0 && (
      <section class="project-gallery" aria-label="Project images">
        {data.gallery.map((image) => (
          <figure>
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              decoding="async"
            />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

  </main>
</Base>
