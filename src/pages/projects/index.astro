---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getPublishedProjects } from '../../lib/projects';
import '../../styles/personal-home.css';
const projects = await getPublishedProjects();
---

<Base
  title="Projects and Experiences — Jeff Li"
  description="A growing collection of projects, experiments, and lessons learned."
>
  <div class="personal-home">
    <Header illustrated />
    <main id="main" class="personal-copy">
      <div class="personal-reading">
        <h1>Some Interesting Projects I’ve Worked On</h1>
        <ol class="entry-list">
          {projects.map((project) => (
            <li>
              <span class="entry-date">
                {project.data.sample ? 'Sample' : project.data.year}
              </span>
              <a class="entry-row" href={`/projects/${project.id}/`}>
                <h2>{project.data.title}</h2>
                <p class="entry-summary">{project.data.summary}</p>
              </a>
            </li>
          ))}
        </ol>
        {projects.length === 0 && (
          <p class="empty-state">
            The collection is still growing. Check back soon.
          </p>
        )}
      </div>
    </main>
  </div>
</Base>
