---
import '../styles/global.css';
import NightSky from '../components/NightSky.astro';
interface Props {
  title?: string;
  description?: string;
  preloadImage?: string;
  /** Draw the night sky behind the page. */
  sky?: boolean;
}
const {
  preloadImage,
  sky = false,
  title = 'Jeff Li — Personal portfolio',
  description = 'Meet Jeff Li: projects, thoughtful work, and interests from soccer to astronomy.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0f5fa" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=portrait-1" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=portrait-1" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{title}</title>
  </head>
  <body class:list={{ 'has-sky': sky }}>
    {sky && <NightSky />}
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
